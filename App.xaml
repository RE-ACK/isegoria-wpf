<Application x:Class="isegoria_wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:isegoria_wpf"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IrishGrover">pack://application:,,,/Assets/Fonts/#Irish Grover</FontFamily>
            <FontFamily x:Key="Pretendard">pack://application:,,,/Assets/Fonts/#Pretendard Variable Thin</FontFamily>
            
            
            <!-- 색상 -->
            <SolidColorBrush x:Key="PrimaryColor" Color="#7646FF"/>
            <SolidColorBrush x:Key="ForegroundColor" Color="#CCCCEE"/>
            <SolidColorBrush x:Key="BorderColor" Color="#3D2B7A"/>
            <SolidColorBrush x:Key="InputBackground" Color="#1A1A2E"/>
            <SolidColorBrush x:Key="SubTextColor" Color="#8878CC"/>
            <Color x:Key="GradientStart">#743CFF</Color>
            <Color x:Key="GradientEnd">#8083FF</Color>

        </ResourceDictionary>
         
    </Application.Resources>
</Application>
