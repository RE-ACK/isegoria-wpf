<Application x:Class="isegoria_wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:isegoria_wpf">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IrishGrover">pack://application:,,,/Assets/Fonts/#Irish Grover</FontFamily>
            <FontFamily x:Key="Pretendard">pack://application:,,,/Assets/Fonts/#Pretendard Variable Thin</FontFamily>
            
            
            <!-- 색상 -->
            <Color x:Key="GradientStart">#743CFF</Color>
            <Color x:Key="GradientEnd">#8083FF</Color>
            
            <SolidColorBrush x:Key="BorderColor" Color="{StaticResource GradientStart}"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#283044"/>
            <SolidColorBrush x:Key="SideBarColor" Color="#131B2E" />
            <SolidColorBrush x:Key="ButtonHoverColor" Color="#33743CFF" />
            <SolidColorBrush x:Key="CreateServerColor" Color="#2DB7F2" />
            <SolidColorBrush x:Key="JoinServerColor" Color="#4EDEA3" />
            <SolidColorBrush x:Key="ChannelBasicColor" Color="#353D53" />
            <SolidColorBrush x:Key="ChannelBorderColor" Color="#535761" />

            <!-- 스타일 -->

        </ResourceDictionary>
         
    </Application.Resources>
</Application>
