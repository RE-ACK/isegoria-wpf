<Application x:Class="isegoria_wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:isegoria_wpf">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="IrishGrover">pack://application:,,,/Assets/Fonts/#Irish Grover</FontFamily>
            <FontFamily x:Key="Pretendard">pack://application:,,,/Assets/Fonts/#Pretendard Variable Thin</FontFamily>
            
            
            <!-- 색상 -->
            <Color x:Key="GradientStart">#743CFF</Color>
            <Color x:Key="GradientEnd">#8083FF</Color>
            
            <SolidColorBrush x:Key="BorderColor" Color="{StaticResource GradientStart}"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#283044"/>

        </ResourceDictionary>
         
    </Application.Resources>
</Application>
