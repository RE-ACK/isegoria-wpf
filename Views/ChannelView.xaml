<UserControl x:Class="isegoria_wpf.Views.ChannelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:isegoria_wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1180">

    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.ColumnDefinitions>
            <!-- 채널 목록 -->
            <ColumnDefinition Width="220" />
            <!-- 채팅 -->
            <ColumnDefinition Width="*" />
            <!-- 멤버 목록 -->
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>

        <!-- 채널 목록 -->
        <Border Grid.Column="0"
                Background="{StaticResource ChannelBasicColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 서버 이름 -->
                    <RowDefinition Height="50" />
                    <!-- 채널 목록 -->
                    <RowDefinition Height="*" />
                    <!-- 음성 연결 상태 -->
                    <RowDefinition Height="Auto" />
                    <!-- 내 정보 -->
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <!-- 서버 이름 -->
                <Border Grid.Row="0"
                        BorderBrush="{StaticResource ChannelBorderColor}"
                        BorderThickness="0,0,0,1">
                    <TextBlock x:Name="ServerNameText"
                               Text="서버 이름"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Padding="18,18,18,18" />
                </Border>

                <!-- 채널 목록 -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              Padding="18,18,18,18">
                    <StackPanel>
                        <!-- 텍스트 채널 카테고리 -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/arrow_right_icon.png"
                                   Width="15"
                                   Height="15" />
                            <TextBlock Text="채팅"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="14,0,0,0" />
                        </StackPanel>

                        <!-- 채널 아이템 예시 -->
                        <Button x:Name="ChannelItem"
                                HorizontalContentAlignment="Left"
                                Background="Transparent"
                                Margin="0,6"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ChannelBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="18,6">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Image Source="/Assets/chat_icon.png"
                                                   Width="15"
                                                   Height="15" />
                                            <TextBlock Text="채팅채널1"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="ChannelBorder"
                                                    Property="Background"
                                                    Value="#2A2640" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 음성 채널 카테고리 -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/arrow_right_icon.png"
                                   Width="15"
                                   Height="15" />
                            <TextBlock Text="음성"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="Medium"
                                       Margin="14,0,0,0" />
                        </StackPanel>

                        <Button HorizontalContentAlignment="Left"
                                Background="Transparent"
                                Margin="0,6"
                                Cursor="Hand"
                                Click="VoiceChannel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ChannelBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="18,6">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Image Source="/Assets/voice_icon.png"
                                                   Width="15"
                                                   Height="15" />
                                            <TextBlock Text="음성채널1"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="ChannelBorder"
                                                    Property="Background"
                                                    Value="#2A2640" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- 참여자 목록 (항상 표시, 없으면 Collapsed) -->
                        <StackPanel x:Name="VoiceParticipants"
                                    Visibility="Collapsed"
                                    Margin="34,0,0,0">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,4">
                                <Ellipse Width="15"
                                         Height="15"
                                         Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="/Assets/default_profile.png" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="사용자명"
                                           Foreground="White"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        x:Name="VoiceStatusBar"
                        Background="#1E3A2E"
                        BorderBrush="#2DB77F"
                        BorderThickness="0,1,0,0"
                        Padding="12,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 연결 정보 -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/voice_icon.png"
                                       Width="14"
                                       Height="14"
                                       Margin="0,0,6,0" />
                                <TextBlock Text="음성 연결됨"
                                           Foreground="{StaticResource JoinServerColor}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="VoiceChannelNameText"
                                       Text="채널명 / 서버명"
                                       Foreground="#AAAACC"
                                       FontSize="11"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 통화 종료 버튼 -->
                        <Button Grid.Column="1"
                                Width="32"
                                Height="32"
                                Cursor="Hand"
                                Click="LeaveVoice_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LeaveBorder"
                                            Background="Red"
                                            CornerRadius="6">
                                        <Image Source="/Assets/call_slash_icon.png"
                                               Width="16"
                                               Height="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="LeaveBorder"
                                                    Property="Background"
                                                    Value="#E04040" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 내 정보 -->
                <Border Grid.Row="3"
                        Background="{StaticResource ChannelBasicColor}"
                        BorderBrush="{StaticResource ChannelBorderColor}"
                        BorderThickness="0,1,0,0"
                        Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!-- 사용자명 -->
                            <ColumnDefinition Width="Auto" />
                            <!-- 아이콘들 -->
                        </Grid.ColumnDefinitions>

                        <!-- 사용자명 -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="UsernameText"
                                       Text="사용자명"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UserTagText"
                                       Text="#0001"
                                       Foreground="{StaticResource BorderColor}"
                                       FontSize="11" />
                        </StackPanel>

                        <!-- 아이콘들 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Margin="0,0,12,0"
                                    Cursor="Hand"
                                    Click="VoiceToggle_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="VoiceBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="2">
                                            <Image x:Name="VoiceIcon"
                                                   Source="/Assets/voice_icon.png"
                                                   Width="24"
                                                   Height="24" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="VoiceBorder"
                                                        Property="Background"
                                                        Value="#2A2640" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Margin="0,0,12,0"
                                    Cursor="Hand"
                                    Click="MicToggle_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MicBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="2">
                                            <Image x:Name="MicIcon"
                                                   Source="/Assets/mic_icon.png"
                                                   Width="24"
                                                   Height="24" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="MicBorder"
                                                        Property="Background"
                                                        Value="#2A2640" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Cursor="Hand"
                                    Click="Setting_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SettingBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="2">
                                            <Image x:Name="SettingIcon"
                                                   Source="/Assets/setting_icon.png"
                                                   Width="24"
                                                   Height="24" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="SettingBorder"
                                                        Property="Background"
                                                        Value="#2A2640" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 채팅 영역 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- 채널 이름 -->
                <RowDefinition Height="50" />
                <!-- 메시지 목록 -->
                <RowDefinition Height="*" />
                <!-- 입력창 -->
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>

            <!-- 채널 이름 -->
            <Border Grid.Row="0"
                    BorderBrush="#3D3A6B"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0">
                    <Image Source="/Assets/chat_icon.png"
                           Width="15"
                           Height="15" />
                    <TextBlock Text="일반"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="12, 0,0,0" />
                </StackPanel>
            </Border>

            <!-- 메시지 목록 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="MessageList"
                            Margin="16,16,16,0" />
            </ScrollViewer>

            <!-- 입력창 -->
            <Border Grid.Row="2"
                    Padding="12,0">
                <Border Background="{StaticResource ChannelBasicColor}"
                        CornerRadius="10"
                        Padding="16,0"
                        Margin="0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Cursor="Hand"
                                Click="Add_File_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddCircleBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Width="28"
                                            Height="28">
                                        <Image Source="/Assets/add_circle_icon.png"
                                               Width="24"
                                               Height="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="AddCircleBorder"
                                                    Property="Background"
                                                    Value="#2A2640" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBox Grid.Column="1"
                                 x:Name="MessageInput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontSize="14"
                                 VerticalAlignment="Center"
                                 Padding="12,0" />

                        <Button Grid.Column="2"
                                Cursor="Hand"
                                Click="Send_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SendBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Width="28"
                                            Height="28">
                                        <Image x:Name="SendIcon"
                                               Source="/Assets/send_icon.png"
                                               Width="24"
                                               Height="24" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="SendBorder"
                                                    Property="Background"
                                                    Value="#2A2640" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- 멤버 목록 -->
        <Border Grid.Column="2"
                Background="{StaticResource ChannelBasicColor}">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="8,16,8,0">

                    <!-- 온라인 -->
                    <TextBlock x:Name="OnlineCountText"
                       Text="온라인"
                       Foreground="{StaticResource BorderColor}"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="8,0,0,8"/>
                    <StackPanel x:Name="OnlineMemberList" Margin="8,0,0,8"/>

     
                    <!-- 오프라인 -->
                    <TextBlock x:Name="OfflineCountText"
                               Text="오프라인"
                               Foreground="{StaticResource BorderColor}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="8,16,0,8" />

                    <StackPanel x:Name="OfflineMemberList" Margin="8,0,0,8">
                        
                        
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>