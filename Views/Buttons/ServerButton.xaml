<UserControl x:Class="isegoria_wpf.Views.Buttons.ServerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:isegoria_wpf.Views.Buttons"
             mc:Ignorable="d"
             x:Name="Root">

    <StackPanel>
        <Button Style="{StaticResource ServerButtonStyle}"
                HorizontalAlignment="Center"
                Margin="0,0,0,4"
                Click="ServerButton_Click"
                ToolTip="{Binding ServerName, ElementName=Root}">
            <Image Source="{Binding IconUrl, ElementName=Root}"
                   Width="35" Height="35"/>
        </Button>

       
    </StackPanel>
</UserControl>