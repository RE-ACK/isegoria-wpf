<UserControl x:Class="isegoria_wpf.Views.Buttons.MemberButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:isegoria_wpf.Views.Buttons"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

        <!-- 프로필 이미지 + 상태 점 -->
        <Grid Width="32" Height="32" Margin="0,0,8,0">
            <Ellipse Width="32" Height="32">
                <Ellipse.Fill>
                    <ImageBrush>
                        <ImageBrush.ImageSource>
                            <Binding Path="AvatarUrl" ElementName="Root">
                                <Binding.FallbackValue>
                                    <BitmapImage UriSource="pack://application:,,,/Assets/default_profile.png"/>
                                </Binding.FallbackValue>
                                <Binding.TargetNullValue>
                                    <BitmapImage UriSource="pack://application:,,,/Assets/default_profile.png"/>
                                </Binding.TargetNullValue>
                            </Binding>
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 상태 점 -->
            <Ellipse Width="10" Height="10"
                     Fill="{Binding StatusColor, ElementName=Root}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"/>
        </Grid>
        <!-- 유저 이름 -->
        <TextBlock Text="{Binding Username, ElementName=Root}"
                   Foreground="{Binding TextColor, ElementName=Root}"
                   FontSize="13"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
