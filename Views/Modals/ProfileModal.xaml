<Window x:Class="isegoria_wpf.Views.Modals.ProfileModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProfileModal"
        Width="500"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        xmlns:vm="clr-namespace:isegoria_wpf.ViewModels">

    <Window.DataContext>
        <vm:AuthViewModel />
    </Window.DataContext>

    <Grid>
        <Border CornerRadius="12"
                Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                ClipToBounds="True"
                Width="500"
                Height="300"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel VerticalAlignment="Center"
                        Margin="40,0">

                <!-- 타이틀 -->
                <TextBlock Text="내 정보"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <!-- 유저 정보 -->
                <Border Background="{StaticResource SideBarColor}"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 프로필 이미지 -->
                        <Button Grid.Column="0"
                                Width="48"
                                Height="48"
                                Cursor="Hand"
                                Click="ProfileImage_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Width="48"
                                             Height="48">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileImageBrush"
                                                        ImageSource="/Assets/default_profile.png" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- 유저명 / 태그 -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0">

                            <!-- 일반 표시 -->
                            <TextBlock x:Name="UsernameText"
                                       Text="JIK-K"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold" />

                            <!-- 편집 모드 -->
                            <TextBox x:Name="UsernameInput"
                                     Style="{StaticResource InputBoxStyle}"
                                     Text="JIK-K"
                                     Visibility="Collapsed"
                                     Height="32" />

                            <TextBlock Text="#0001"
                                       Foreground="{StaticResource BorderColor}"
                                       FontSize="11" />
                        </StackPanel>

                        <!-- 설정 아이콘 -->
                        <Button Grid.Column="2"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                Click="SettingButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SettingBorder"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Width="28"
                                            Height="28">
                                        <Image Source="/Assets/user_edit_icon.png"
                                               Width="20"
                                               Height="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="SettingBorder"
                                                    Property="Background"
                                                    Value="{StaticResource ButtonHoverColor}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>


                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="11"
                           Margin="0,4,0,0" />

                <!-- 버튼 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                            Height="44"
                            Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CancelBorder"
                                        Background="#2A2640"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <TextBlock Text="취소"
                                               Foreground="White"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="CancelBorder"
                                                Property="Background"
                                                Value="#3A3650" />
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                             Value="True">
                                        <Setter TargetName="CancelBorder"
                                                Property="Background"
                                                Value="#1A1630" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            Content="확인"
                            Height="44"
                            Cursor="Hand"
                            Command="{Binding UpdateUserInfoCommand}"
                            Style="{StaticResource LoginButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>