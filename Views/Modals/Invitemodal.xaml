<Window x:Class="isegoria_wpf.Views.Modals.InviteModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:isegoria_wpf.Views.Modals"
             mc:Ignorable="d" 
        
             Height="320"
             Width="560"
             >
    <Grid>
        <Border CornerRadius="12"
                Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                ClipToBounds="True"
                Width="560"
                Height="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel VerticalAlignment="Center"
                        Margin="40,0">

                <!-- 타이틀 -->
                <TextBlock Text="서버  초대하기"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32" />

                <!-- 라벨 -->
                <TextBlock Text="서버 초대 링크 복사하기"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <!-- 코드 입력창 + 복사 버튼 -->
                <Border Background="{StaticResource BackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Height="52">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="InviteCodeText"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Padding="16,0,0,0" />

                        <!-- 복사 버튼 -->
                        <Button Grid.Column="1"
                                x:Name="CopyButton"
                                Width="80"
                                Height="40"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                Click="CopyButton_Click"
                                Style="{StaticResource LoginButtonStyle}">
                            <Button.Content>
                                <TextBlock x:Name="CopyButtonText"
                                           Text="복사"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

                <!-- 안내 문구 -->
                <TextBlock Text="초대 링크는 영구히 유지돼요."
                           Foreground="{StaticResource BorderColor}"
                           FontSize="12"
                           Margin="0,10,0,0" />

            </StackPanel>
        </Border>
    </Grid>

</Window>
