<Window x:Class="isegoria_wpf.Views.Modals.InviteModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:isegoria_wpf.Views.Modals"
             Title="InviteModal"
             mc:Ignorable="d" 
             WindowStartupLocation="CenterOwner"
             ResizeMode="NoResize"
             WindowStyle="None"
             AllowsTransparency="True"
             Background="Transparent"
             Height="190"
             Width="500"
             >
    <Grid>
        <Border CornerRadius="12"
                Background="{StaticResource BackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                ClipToBounds="True"
                Width="500"
                Height="190"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel VerticalAlignment="Center"
                        Margin="20,0">

                <!-- 타이틀 -->
                <Grid Margin="0,0,0,15" >
                    <TextBlock Text="서버  초대하기"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" />
                    <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="CloseButton_Click" Margin="400,0,0,0" 
                        >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <Image 

                                        Source="/Assets/close-circle.png"
                                        Width="24" Height="24" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>


                <!-- 라벨 -->
                <TextBlock Text="서버 초대 링크 복사하기"
                           FontFamily="{StaticResource Pretendard}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <!-- 코드 입력창 + 복사 버튼 -->
                <Border Background="{StaticResource BackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Height="52">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="InviteCodeText"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 FontSize="14"
                                 IsReadOnly="True"
                                 VerticalAlignment="Center"
                                 Padding="16,0,0,0" />

                        <!-- 복사 버튼 -->
                        <Button Grid.Column="1"
                                x:Name="CopyButton"
                                Width="80"
                                Height="40"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                Click="CopyButton_Click"
                                Style="{StaticResource LoginButtonStyle}">
                            <Button.Content>
                                <TextBlock x:Name="CopyButtonText"
                                           Text="복사"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Button.Content>
                        </Button>
                    </Grid>
                </Border>

                <!-- 안내 문구 -->
                <TextBlock Text="초대 링크는 영구히 유지돼요."
                           Foreground="White"
                           FontSize="12"
                           Margin="0,10,0,10" />

            </StackPanel>
        </Border>
    </Grid>

</Window>
