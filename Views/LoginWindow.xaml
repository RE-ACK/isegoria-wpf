<Window x:Class="isegoria_wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:isegoria_wpf.Views"
        mc:Ignorable="d"
        Title="LoginWindow" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- 입력 필드 스타일 -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontFamily" Value="Irish Grover"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 비밀번호 박스 스타일 -->
        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 로그인 버튼 스타일 -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource GradientStart}" Offset="0"/>
                                    <GradientStop Color="{StaticResource GradientEnd}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 링크 버튼 스타일 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8878CC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="#B8A8FF"/>
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource BackgroundColor}" ClipToBounds="True">

        <Grid>
            <!-- 배경 장식 글로우 -->

            <!-- 닫기 버튼 -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,14,0"
                    Width="28" Height="28"
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="Transparent"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="6" Width="28" Height="28">
                            <TextBlock Text="✕" Foreground="White" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#33743CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 메인 콘텐츠 -->
            <StackPanel VerticalAlignment="Center" Margin="60,0">

                <!-- 로고 아이콘 -->
                <Image Source="/Assets/isegoria_icon.png"
                       Width="72" Height="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- 브랜드명 -->
                <TextBlock Text="ISEGORIA"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource IrishGrover}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Light"
                           Margin="0,0,0,48">
                </TextBlock>

                <!-- 아이디 입력 -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="아이디"
                               Foreground="White"
                               FontFamily="{StaticResource Pretendard}"
                               FontSize="12"
                               Margin="4,0,0,6"/>
                    <TextBox x:Name="UsernameInput"
                             Style="{StaticResource InputBoxStyle}"/>
                </StackPanel>

                <!-- 패스워드 입력 -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="비밀번호"
                               Foreground="White"
                               FontFamily="{StaticResource Pretendard}"
                               FontSize="12"
                               Margin="4,0,0,6"/>
                    <PasswordBox x:Name="PasswordInput"
                                 Style="{StaticResource PasswordBoxStyle}"/>
                </StackPanel>

                <!-- 로그인 버튼 -->
                <Button Content="로그인"
                        Style="{StaticResource LoginButtonStyle}"
                        Click="LoginButton_Click"
                        Margin="0,0,0,20"/>

                <!-- 아이디/비밀번호 찾기 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="아이디 찾기"
                            FontSize="14"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="FindId_Click"/>
                    <TextBlock Text="    |    "
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="14"/>
                    <Button Content="비밀번호 찾기"
                            FontSize="14"
                            Style="{StaticResource LinkButtonStyle}"
                            Click="FindPassword_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
    
</Window>
 